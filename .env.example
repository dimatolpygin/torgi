# ===== Целевой сайт =====
SITE_BASE_URL=https://gorod.it-minsk.by
# Минский Комаровский рынок
RINOK_ID=10
# Ассортимент: 1-картофель, 2-овощи, 3-зелень, 4-плоды, 5-ягоды, 6-яблоки
ASSORT_IDS=2

# ===== Тайминг =====
TZ_NAME=Europe/Minsk
PREPARE_LEAD_SECONDS=120
# true = не отправлять реальную заявку (безопасно для тестов)
DRY_RUN=true
# Маскировка (этап 17): при BOOKINGS_PER_ACCOUNT=2 вторая заявка уходит не сразу,
# а через паузу из диапазона [SUBMIT_GAP_MIN_MS, SUBMIT_GAP_MAX_MS] (мс), чтобы в
# утренних списках админов не было «мгновенного дубля» одного имени.
# По решению клиентки разрыв ФИКСИРОВАННЫЙ — 1 с (min=max=1000, дефолт).
# Если задать min<max — пауза станет случайной из диапазона.
# SUBMIT_GAP_MIN_MS=1000
# SUBMIT_GAP_MAX_MS=1000
# Упреждение выстрела (этап 20): за сколько мс до 00:00 отправлять заявку, чтобы она
# ПРИЛЕТЕЛА ближе к 00:00:00.000 (компенсация сетевой задержки). Потолок = сетевой
# one-way (на BY ≈ 0.7 мс). Больше → заявка прилетит до открытия даты (no_date), тогда
# сработает безопасный фолбэк (повтор ровно в 00:00). ДЕФОЛТ 0 = выключено; включать
# осознанно после калибровки границы по живым ночам (см. check-rtt.js).
# SEND_AHEAD_MS=0
# Лёгкий путь и число проб для замера сетевого RTT на прогреве (статика).
# RTT_PROBE_PATH=/js/rinki/rinki.reg.js
# RTT_PROBE_SAMPLES=7
# ⛔ Диагностический замер часов сайта и RTT перед подачей. ВЫКЛЮЧЕН ПО УМОЛЧАНИЮ:
# он делал ~130 запросов за 11 с за две минуты до выстрела и в ночь 30.07.2026 словил
# бан IP на час (сайт закрыл TCP, 0 мест из 4). На подачу не влияет — только строки
# «Часы сайта»/«Сеть» в отчёте разработчику. Включать осознанно.
# CLOCK_PROBE=false
# Дедлайн на прогрев соединения перед 00:00 (мс): прогрев идёт по боевым сокетам, и
# повисший GET мог утащить выстрел за полночь. По дедлайну прогрев бросаем.
# WARM_DEADLINE_MS=2500
# ⛔ ГЛАВНОЕ ПО БАНУ: сайт банит IP на час за ВХОД пачкой (два POST /login/ в одну
# секунду = сигнатура перебора пароля). Воспроизведено вживую 31.07.2026, из-за этого
# потеряны ночи 30.07 и 31.07 (0 мест из 4). Поэтому:
#  - сторож сессий держит куки живыми, и ночью вход НЕ ТРЕБУЕТСЯ;
#  - если вход всё же нужен, входы сериализуются и разносятся на LOGIN_MIN_GAP_MS.
# LOGIN_MIN_GAP_MS=45000
# SESSION_KEEPALIVE_MS=600000   # как часто продлевать сессии (0 — выключить сторожа)
# KEEPER_STAGGER_MS=20000       # разнос кабинетов внутри тика
# KEEPER_LOGIN_RETRY_MS=900000  # не чаще этого пробуем войти, если сессия протухла
# KEEPER_QUIET_BEFORE_MIN=20    # тихое окно сторожа до полуночи
# KEEPER_QUIET_AFTER_MIN=10     # и после
# SESSION_TTL_SEC=108000        # 30 ч — больше суток между подачами
# Предохранитель от подкормки бана: если сайт РАЗРЫВАЕТ соединение (ECONNREFUSED — это
# уже блокировка IP), после N отказов подряд долбёжка встаёт на паузу, а не долбит
# каждые 4 с (в ночь 30.07.2026 бот сделал 399 таких попыток и продлевал себе бан).
# RETRY_CONN_BREAK_STREAK=3
# RETRY_CONN_COOLDOWN_MS=600000
# Мультиконнект (этап 21): выстрелить ПЕРВОЙ (гоночной) заявкой параллельно по K тёплым
# соединениям (одна сессия, разные сокеты) и взять первый принятый — борьба с джиттером
# одного сокета. Лишние приёмы гасятся отменой (в ЛК ровно нужное). K=1 = выключено
# (текущее поведение). Включать осознанно после живой калибровки. Разумный старт — 2–3.
# MULTICONNECT_K=1

# ===== Аккаунты (заполняются позже, на этапе 1/6) =====
# Формат: логин:пароль через запятую между аккаунтами
# ACCOUNTS=1121298c017rb8:607404

# ===== Postgres =====
PGHOST=postgres
PGPORT=5432
PGUSER=bron
PGPASSWORD=bron
PGDATABASE=bron

# ===== Redis =====
REDIS_HOST=redis
REDIS_PORT=6379
# Необязательно: TTL сессионной куки и флага «сегодня подано» (секунды)
# SESSION_TTL_SEC=43200
# DONE_TTL_SEC=259200

# ===== Telegram =====
TELEGRAM_BOT_TOKEN=
# Заранее заданные chat_id через запятую — это операторские чаты (роль dev,
# получают всё + состояние сервера). Подписываются ещё до кодового слова.
# TELEGRAM_CHAT_IDS=
# Кодовые слова для подписки с ролью. Формат: слово:роль:метка через запятую.
# Роли: wife (жена), husband (муж), dev (разработчик — надмножество).
# Жена/муж получают итоги брони и алерты; dev — ещё и состояние сервера.
# TELEGRAM_CODE_WORDS=komarovka-wife:wife:Жена,komarovka-muzh:husband:Муж,komarovka-dev:dev:Разработчик
# Привязка аккаунт→роль для персонального тайминга (этап 18): "подстрока_логина:роль".
# Жене/мужу после успешной подачи приходит время ИХ кабинета (1-я и 2-я заявка).
# Матчим по стабильной части логина (логин на сайте меняется по дням).
# ACCOUNT_ROLES=4131195:wife,3080391:husband

# ===== Мониторинг сервера (этап 16) =====
# Pre-flight: слать разработчику «жив, готов к подаче» при ночном прогреве (true/false).
# Отсутствие этого сообщения ~23:58 = бот не дошёл до прогрева.
# HEALTH_PREFLIGHT=true

# ===== Логи =====
LOG_LEVEL=info
